# Freesound API credentials.
#
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.template .env
#
# `.env` is gitignored; never commit it.
#
# Get credentials by creating a Freesound account and applying for an API key at
# https://freesound.org/apiv2/apply/. The application page shows both values.

FREESOUND_CLIENT_ID=
FREESOUND_API_KEY=
